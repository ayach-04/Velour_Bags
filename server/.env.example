# Server Port
PORT=3000

# MongoDB (REQUIRED — no fallback, server will refuse to start without it)
MONGO_URI=

# JWT (REQUIRED — no fallback, server will refuse to start without it)
JWT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP) — order notifications sent here
NOTIFICATION_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
